# ============================================================
# BOOTSTRAP — semuanya opsional.
# Semua konfigurasi lain diatur dari dashboard dan disimpan di database.
# ============================================================

# Direktori data (database, secret, backup).
DATA_DIR=./data

# Alamat bind API dashboard.
#   127.0.0.1 = hanya dari dalam host (paling aman, default)
#   0.0.0.0   = JANGAN di server ber-IP publik
API_HOST=127.0.0.1
API_PORT=8080

# Zona waktu untuk timestamp log dan database.
TZ=Asia/Makassar

# ============================================================
# REVERSE PROXY (opsional)
# ============================================================
# Alamat reverse proxy yang X-Forwarded-For-nya dipercaya, dipisah koma.
# Hanya header dari alamat ini yang dibaca; header dari klien lain diabaikan.
#
#   127.0.0.1        = proxy di mesin yang sama (default)
#   172.17.0.1       = proxy berupa container Docker di mesin yang sama
#   10.0.0.5,127.0.0.1
#
# Penting: tanpa nilai yang benar, audit log mencatat IP proxy dan batas
# percobaan login per-IP menjadi satu kuota bersama untuk semua pengguna.
FORWARDED_ALLOW_IPS=127.0.0.1
