# ── Backend (Python) ──
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Runtime data. Anchored with a leading slash on purpose: a bare `backup/` or
# `logs/` also matched real source directories (backend/src/tuyabot/backup/,
# frontend/src/routes/(app)/backup/ and .../logs/), which silently dropped
# those packages from the repository.
/data/
/backup/
/logs/
*.db
*.db-wal
*.db-shm
.env
.env.dockhand
.superpowers/
referensi/

# ── Frontend (Node) ──
node_modules/
.pnpm-store/
/build/
/.svelte-kit/
/dist/
.env.local

# ── Umum ──
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Local data, matched explicitly at every level the repo uses. `data/` above
# already covers backend/data, but a file here is cheap insurance against a
# future layout change putting a database or secret.key inside the repo.
backend/data/
data/*.db
data/*.db-wal
data/*.db-shm
data/secret.key

# Env files anywhere (the .env.example files are re-included below).
**/.env
!**/.env.example

# Screenshot lokal (untuk laporan manual, bukan bagian repo)
Screenshot *.png
Screenshot*.png
*.tmp

# Screenshot yang ditaruh di docs/ tetap terabaikan, apa pun namanya
docs/*.png
docs/*.jpg
docs/*.jpeg
docs/*.webp
docs/*.gif

# Artefak screenshot dari suite e2e (hanya ditulis bila SHOT_DIR disetel)
frontend/*.png
frontend/*.jpg
frontend/*.jpeg
frontend/*.webp
